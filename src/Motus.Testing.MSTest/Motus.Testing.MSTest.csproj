<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageId>Motus.Testing.MSTest</PackageId>
    <Title>Motus.Testing.MSTest</Title>
    <Description>MSTest 3 integration for Motus browser automation. Provides a base test class with per-test browser context isolation. For MSTest 4, use Motus.Testing.MSTest.v4.</Description>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Motus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motus.Testing\Motus.Testing.csproj" />
    <ProjectReference Include="..\Motus.Abstractions\Motus.Abstractions.csproj" />
  </ItemGroup>

  <!-- Capped below 4: a base class built against MSTest 3 has its setup and cleanup ignored by
       MSTest 4, so a project on 4 that picks this package up is told at restore (NU1608) rather
       than by tests that never get a page. Motus.Testing.MSTest.v4 builds this source for 4. -->
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="[3.5.2, 4.0.0)" />
  </ItemGroup>

</Project>
