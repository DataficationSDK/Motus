<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="3.5.2" />
    <PackageReference Include="SkiaSharp" Version="2.88.*" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.*" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- An MSTest 4 TestContext for the runner tests, which load it by path rather than reference
         it, the way the runners meet a test assembly built against MSTest 4. -->
    <PackageDownload Include="MSTest.TestFramework" Version="[4.0.1]" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NuGetPackageRoot</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- A suite on the oldest published Motus, which the visual runner runs in a test host from its
         own output folder rather than referenced. Its path reaches the tests as metadata. -->
    <ProjectReference Include="..\Fixtures\Motus.Fixtures.OldMotus.Tests\Motus.Fixtures.OldMotus.Tests.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OldMotusFixtureOutput</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\Fixtures\Motus.Fixtures.OldMotus.Tests\bin\$(Configuration)\</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Motus\Motus.csproj" />
    <ProjectReference Include="..\..\src\Motus.Abstractions\Motus.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Motus.Runner\Motus.Runner.csproj" />
    <ProjectReference Include="..\..\src\Motus.Testing.MSTest\Motus.Testing.MSTest.csproj" />
    <ProjectReference Include="..\..\src\Motus.Codegen\Motus.Codegen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
