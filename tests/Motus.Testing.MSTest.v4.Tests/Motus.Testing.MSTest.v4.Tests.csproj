<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- MSTest's own warning that an inherited [TestInitialize] or [TestCleanup] comes from a base
         built against another MSTest major and will be ignored. That is the break this project
         exists to catch, so it fails the build instead of passing quietly. -->
    <WarningsAsErrors>$(WarningsAsErrors);MSTEST0082</WarningsAsErrors>
  </PropertyGroup>

  <!-- As `dotnet new mstest` sets it up today. -->
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Motus.Testing.MSTest.v4\Motus.Testing.MSTest.v4.csproj" />
  </ItemGroup>

</Project>
